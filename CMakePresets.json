{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"warnings": { "dev": false },
			"cacheVariables": {
				"CMAKE_POLICY_VERSION_MINIMUM": "3.5"
			}
		},
		{
			"name": "vs2019",
			"displayName": "Visual Studio 2019 (v142), x64",
			"inherits": "base",
			"generator": "Visual Studio 16 2019",
			"architecture": "x64"
		},
		{
			"name": "vs2026",
			"displayName": "Visual Studio 2026 (v145), x64 - needs a registered VS 2026 instance (Build Tools only: use ninja-msvc)",
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64"
		},
		{
			"name": "ninja-msvc",
			"displayName": "Ninja Multi-Config, MSVC from the current developer environment (wrap commands with scripts/msvc-env.cmd)",
			"inherits": "base",
			"generator": "Ninja Multi-Config",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "ninja-msvc-asan",
			"displayName": "ninja-msvc with AddressSanitizer (ESTREE_SANITIZE); needs a toolset that ships the x64 ASan runtime: set VCVARS64 to the VS 2019 Build Tools vcvars64.bat (VS 18 here only has the x86 runtime)",
			"inherits": "ninja-msvc",
			"cacheVariables": {
				"ESTREE_SANITIZE": "ON"
			}
		},
		{
			"name": "vs2019-asan",
			"displayName": "Visual Studio 2019 (v142), x64 with AddressSanitizer (ESTREE_SANITIZE)",
			"inherits": "vs2019",
			"cacheVariables": {
				"ESTREE_SANITIZE": "ON"
			}
		}
	],
	"buildPresets": [
		{ "name": "vs2019-debug", "configurePreset": "vs2019", "configuration": "Debug" },
		{ "name": "vs2019-release", "configurePreset": "vs2019", "configuration": "Release" },
		{ "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
		{ "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
		{ "name": "ninja-msvc-debug", "configurePreset": "ninja-msvc", "configuration": "Debug" },
		{ "name": "ninja-msvc-release", "configurePreset": "ninja-msvc", "configuration": "Release" },
		{ "name": "ninja-msvc-asan-debug", "configurePreset": "ninja-msvc-asan", "configuration": "Debug" },
		{ "name": "vs2019-asan-debug", "configurePreset": "vs2019-asan", "configuration": "Debug" }
	]
}
